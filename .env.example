# Copy to .env for local runs. In CI these come from GitHub Secrets (see SETUP.md).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# GitHub PAT (classic) with the "gist" scope — creates/updates the state gist
GIST_TOKEN=
# Filled in by bootstrap.py (or the first CI run); add as a GitHub secret too
GIST_ID=
# ScraperAPI free key (optional) — routes Cloudflare-guarded LV aggregators through
# it in CI; leave empty for local runs (direct requests/playwright from your IP works)
SCRAPERAPI_KEY=
